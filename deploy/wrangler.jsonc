// Publicação no Cloudflare (Workers, só arquivos estáticos): não há código rodando no servidor.
// Os arquivos vêm de web/ e os cabeçalhos de segurança de web/_headers.
{
  "name": "scanner-doc",
  "compatibility_date": "2026-09-20",
  "assets": { "directory": "../web" },
  "routes": [{ "pattern": "scanner.sankler.com.br", "custom_domain": true }],
  // Só o endereço oficial: sem cópia em *.workers.dev e sem endereços de prévia.
  "workers_dev": false,
  "preview_urls": false,
  // Sem registro de acessos no Cloudflare e sem estatísticas de uso do próprio wrangler
  // (o send_metrics não cobre todos os eventos; o workflow também define WRANGLER_SEND_METRICS=false).
  "observability": { "enabled": false },
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false }
}
